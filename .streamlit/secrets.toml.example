# Copie este arquivo para ".streamlit/secrets.toml" (localmente) e preencha
# com os valores reais - esse arquivo é só o molde, nunca deve ser
# versionado no Git (já está no .gitignore).
#
# Quando hospedar no Streamlit Community Cloud, esses mesmos valores são
# colados no painel do app (Settings > Secrets), não em arquivo nenhum.
#
# Desde que o chat passou a consultar o banco de dados (Turso) direto em
# vez do Google Sheets, não precisa mais de GOOGLE_SHEETS_ID nem da service
# account aqui - só a chave da Anthropic e as credenciais do Turso.

ANTHROPIC_API_KEY = "coloque_aqui_sua_chave"
TURSO_DATABASE_URL = "coloque_aqui_a_url_do_banco"
TURSO_AUTH_TOKEN = "coloque_aqui_o_token"

# Senha única do painel (ver paginas/_util_auth.py) - sem isso configurado,
# o app não abre pra ninguém. Escolha algo que só você/pessoas de
# confiança saibam - não precisa ser complexo, mas evite algo óbvio.
APP_PASSWORD = "escolha_uma_senha_aqui"
