# Copie este arquivo para ".streamlit/secrets.toml" (localmente) e preencha
# com os valores reais - esse arquivo é só o molde, nunca deve ser
# versionado no Git (já está no .gitignore).
#
# Quando hospedar no Streamlit Community Cloud, esses mesmos valores são
# colados no painel do app (Settings > Secrets), não em arquivo nenhum.
#
# ANTHROPIC_API_KEY e GOOGLE_SHEETS_ID: os mesmos valores que já estão no
# seu .env.
#
# [google_service_account]: o conteúdo do arquivo
# config/google_service_account.json, campo por campo (copie exatamente
# como está no JSON - o "private_key" mantém as quebras de linha \n como
# estão, entre aspas triplas).

ANTHROPIC_API_KEY = "coloque_aqui_sua_chave"
GOOGLE_SHEETS_ID = "coloque_aqui_o_id_da_planilha"

[google_service_account]
type = "service_account"
project_id = "coloque_aqui"
private_key_id = "coloque_aqui"
private_key = "-----BEGIN PRIVATE KEY-----\ncoloque_aqui\n-----END PRIVATE KEY-----\n"
client_email = "coloque_aqui"
client_id = "coloque_aqui"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "coloque_aqui"
universe_domain = "googleapis.com"
