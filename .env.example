# Copie este arquivo para ".env" (sem o ".example") e preencha com os valores reais.
# O arquivo .env nunca deve ser compartilhado, enviado no chat, nem versionado (já está no .gitignore).

# Aplicação criada em https://developers.mercadolivre.com.br
ML_CLIENT_ID=coloque_aqui_seu_client_id
ML_CLIENT_SECRET=coloque_aqui_seu_client_secret
ML_REDIRECT_URI=http://localhost:8000/callback

# Planilha do Google Sheets dedicada a este agente (id extraído da URL da planilha)
GOOGLE_SHEETS_ID=coloque_aqui_o_id_da_planilha

# Chave de API da Anthropic, usada pela análise de IA (agents/analista_ia.py)
ANTHROPIC_API_KEY=coloque_aqui_sua_chave
