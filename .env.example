# Copie este arquivo para ".env" (sem o ".example") e preencha com os valores reais.
# O arquivo .env nunca deve ser compartilhado, enviado no chat, nem versionado (já está no .gitignore).

# Aplicação criada em https://developers.mercadolivre.com.br
ML_CLIENT_ID=coloque_aqui_seu_client_id
ML_CLIENT_SECRET=coloque_aqui_seu_client_secret
ML_REDIRECT_URI=http://localhost:8000/callback

# Planilha do Google Sheets dedicada a este agente (id extraído da URL da planilha)
GOOGLE_SHEETS_ID=coloque_aqui_o_id_da_planilha

# Aplicação criada em https://developer.bling.com.br/aplicativos - usado
# pra buscar o custo de produto (cálculo de margem, Fase B)
BLING_CLIENT_ID=coloque_aqui_seu_client_id
BLING_CLIENT_SECRET=coloque_aqui_seu_client_secret
BLING_REDIRECT_URI=http://localhost:8000/callback

# Chave de API do Gemini, usada pela análise de IA (agents/analista_ia.py)
# e pelo assistente de chat com tool-calling (agents/assistente_ia.py)
GEMINI_API_KEY=coloque_aqui_sua_chave

# Banco de dados hospedado (Supabase/Postgres) - connection string direta
# em supabase.com > seu projeto > Project Settings > Database > Connection
# string (aba URI).
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres

# Banco anterior (Turso) - só necessário se for rodar os scripts de
# migração de uso único (scripts/migrar_para_*.py) ou usar
# database/conexao_turso.py como rollback. Não é mais lido pelo resto do
# projeto.
TURSO_DATABASE_URL=coloque_aqui_a_url_do_banco
TURSO_AUTH_TOKEN=coloque_aqui_o_token
